# ── BFF configuration ───────────────────────────────────────────────
# The backtest engine (hs-compute). The BFF sends POST /backtest here.
ENGINE_BASE_URL=http://localhost:8000

# Port the BFF + chat UI is served on.
PORT=3000

# Anthropic key — lives ONLY here (server-side), never shipped to the browser.
# If unset, the BFF falls back to a deterministic rule-based DSL generator
# so the demo still works end-to-end.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Backtest cost defaults (per the integration guide §8).
DEFAULT_INITIAL_EQUITY=10000
DEFAULT_FEE_BPS=5
DEFAULT_SLIPPAGE_BPS=2
